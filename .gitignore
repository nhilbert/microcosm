# dist/ is NOT ignored: dist/microcosm.jsx is the deliverable artifact
# and is committed deliberately. CI checks it matches src/.

# dev server bundle output
dev/.build/

# full-size species art stays local (10+ MB); the app uses the 640px versions
assets/species/full/

# dev/assets is copied from assets/ by the dev server (no symlink: Windows)
dev/assets/

# Android wrapper: generated web assets + gradle output (tools/build-app.js
# regenerates assets/ from dist/ for every APK build)
android/app/src/main/assets/
android/.gradle/
android/build/
android/app/build/
android/local.properties
