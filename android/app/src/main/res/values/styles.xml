<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pond-dark chrome (#05070C, the artifact's background) on every
         surface the system paints, so the app is one dark pane. -->
    <style name="Theme.Microcosm" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mc_bg</item>
        <item name="android:statusBarColor">@color/mc_bg</item>
        <item name="android:navigationBarColor">@color/mc_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
