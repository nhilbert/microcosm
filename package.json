{
  "name": "microcosm",
  "version": "0.4.0",
  "private": true,
  "description": "A sandbox for artificial organisms: a conserved-matter ecosystem simulator with an observatory that narrates what it sees.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/dev-server.js",
    "build": "python3 tools/build.py",
    "syntax": "node tools/syntax.js",
    "conform": "npm run build && node harness/conform.js",
    "conform:capture": "npm run build && node harness/conform.js --capture",
    "tune": "npm run build && node harness/tune2.js",
    "gate": "npm run build && node harness/k6gate.js",
    "yoshida": "npm run build && node harness/yoshida.js",
    "corridor": "npm run build && node harness/corridor.js",
    "corridor:full": "npm run build && node harness/corridor.js --rails --fuzz --sample 16",
    "gate5": "npm run build && node harness/gate5.js",
    "light": "npm run build && node harness/light.js --patches --seed",
    "light:gate": "npm run build && node harness/light.js --gate",
    "heat:gate": "npm run build && node harness/heat.js --gate",
    "move": "npm run build && node harness/move.js --metrics",
    "move:trap": "npm run build && node harness/move.js --trap",
    "walls": "npm run build && node harness/walls.js",
    "walls:all": "npm run build && node harness/walls.js --open --seal --hideout --shade",
    "apk:assets": "node tools/build-app.js",
    "selftest": "node harness/selftest.js",
    "yoshida:capture": "npm run build && node harness/yoshida.js --capture",
    "test": "npm run build && npm run syntax && node harness/selftest.js && node harness/conform.js",
    "test:full": "npm run test && npm run tune && npm run gate && node harness/gate5.js && node harness/corridor.js --rails --fuzz"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
