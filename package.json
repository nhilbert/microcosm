{
  "name": "microcosm",
  "version": "0.4.0",
  "private": true,
  "description": "A sandbox for artificial organisms: a conserved-matter ecosystem simulator with an observatory that narrates what it sees.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/dev-server.js",
    "build": "python3 tools/build.py",
    "syntax": "esbuild --loader=jsx --log-level=warning < dist/microcosm.jsx > /dev/null",
    "conform": "npm run build && node harness/conform.js",
    "conform:capture": "npm run build && node harness/conform.js --capture",
    "tune": "npm run build && node harness/tune2.js",
    "gate": "npm run build && node harness/k6gate.js",
    "test": "npm run build && npm run syntax && node harness/conform.js",
    "test:full": "npm run test && npm run tune && npm run gate"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
